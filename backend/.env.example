# Copie para backend/.env e ajuste. NUNCA versione o .env real.

# 'production' ativa cookies Secure, redirect https, HSTS e o boot seguro.
NODE_ENV=production

# Porta local onde o Node escuta (o proxy reverso encaminha para cá).
PORT=3000

# Confiança no proxy reverso. 1 = confia no primeiro proxy (nginx/Caddy na mesma máquina).
TRUST_PROXY=1

# URL pública final (https). Usada nos links de e-mail e na checagem de origem.
PUBLIC_URL=https://cursos.seudominio.com.br

# Administrador criado no primeiro boot. Use uma senha forte e única.
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha-por-uma-forte

# Duração da sessão (dias).
SESSION_TTL_DAYS=7

# SMTP para os e-mails de verificação de cadastro.
# Se ficar em branco, o link de verificação é apenas impresso no log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Instituto Skills Manager <no-reply@seudominio.com.br>
